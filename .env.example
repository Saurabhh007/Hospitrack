# ==============================================================================
# HOSPITRACK PLATFORM — PRODUCTION & DEVELOPMENT ENVIRONMENT SPECIFICATION
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit production .env files containing real credentials or secrets to git.

# ------------------------------------------------------------------------------
# 1. Frontend Web Server & Node.js Reverse Proxy Configuration
# ------------------------------------------------------------------------------
# PORT: Port where Node.js web server listens (default: 8000).
# NOTE: Do NOT set to 8080 to prevent collision with Spring Boot.
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Backend Orchestration & Remote API Target (Frontend -> Backend)
# ------------------------------------------------------------------------------
# BACKEND_HOST / BACKEND_PORT: Local Spring Boot address when orchestrated by server.js
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080

# BACKEND_URL / API_BASE_URL: Set this if your backend is hosted on a remote domain.
# When set, Node.js server.js proxies /api/* to this remote endpoint, and frontend
# client connects directly or through reverse proxy to this URL.
# Example: BACKEND_URL=https://api.hospitrack.com
# For local unified development, leave blank or set to http://localhost:8080
API_BASE_URL=http://localhost:8080
BACKEND_URL=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 3. Spring Boot Backend Runtime Configuration
# ------------------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE: 'dev' uses in-memory H2 database; 'prod' requires PostgreSQL.
SPRING_PROFILES_ACTIVE=dev

# SERVER_PORT: Internal Spring Boot Tomcat port (default: 8080)
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 4. PostgreSQL Production Database Configuration (Required when profile=prod)
# ------------------------------------------------------------------------------
# Standard JDBC connection URL for PostgreSQL (e.g. Supabase, Railway, Neon, AWS RDS)
DATABASE_URL=jdbc:postgresql://localhost:5432/hospitrack
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_postgresql_password_here

# Hibernate DDL strategy (default: update for safe non-destructive schema synchronization)
HIBERNATE_DDL_AUTO=update

# Connection pool sizing
DB_POOL_MAX=10
DB_POOL_MIN=2

# ------------------------------------------------------------------------------
# 5. JWT Authentication & Cryptographic Security
# ------------------------------------------------------------------------------
# JWT_SECRET: Must be a cryptographically secure key with at least 256 bits (32+ chars)
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_256_bits_length_for_hmac_sha256_security_production_2026
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------------------------------------------
# 6. CORS Cross-Origin Resource Sharing (Backend Security)
# ------------------------------------------------------------------------------
# FRONTEND_URL / ALLOWED_ORIGINS: Comma-separated list of explicitly allowed origins.
# In production, set this to your exact Vercel frontend URL or custom domain.
# Wildcard '*' is forbidden with credentials. Trailing slashes are automatically trimmed.
# Example: FRONTEND_URL=https://hospitrack.vercel.app,https://your-custom-domain.com
FRONTEND_URL=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 7. Brevo Transactional Email Service (Optional, Backend Only)
# ------------------------------------------------------------------------------
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Hospitrack Healthcare System

# ------------------------------------------------------------------------------
# 8. Controlled Initial Administrator Bootstrap
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin@hospitrack.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_BEFORE_RUNNING

# ------------------------------------------------------------------------------
# 9. JVM Memory Settings (For Containerized Deployments e.g. Railway / Render)
# ------------------------------------------------------------------------------
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=25.0 -XX:+ExitOnOutOfMemoryError

# ------------------------------------------------------------------------------
# 10. Cloud Deployment Notes (Manual Deployment - CI Workflow is Verification Only)
# ------------------------------------------------------------------------------
# GitHub Actions operates as a CI-only verification pipeline. Cloud deployment to
# Railway (backend) and Vercel (frontend) is performed manually via provider dashboards
# or CLI with zero external deployment secrets required in CI.
